# Private Passkey database, separate from the photo library. Initialize with bun run auth init.
AUTH_ROOT=./data/auth
STORAGE_TYPE=local
LIBRARY_ROOT=./data/library-v2
PORT=3000
# Per-process upload limits; excess requests receive 503 with Retry-After.
IMAGE_CONCURRENCY=2
IMAGE_QUEUE_SIZE=8
# Maximum decoded source pixels (60 megapixels); raise only after checking memory.
IMAGE_MAX_PIXELS=60000000
# S3 Configuration (if STORAGE_TYPE=s3)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
# Dedicated v2 namespace; never use uploads/, thumbnails/, or previews/.
S3_PREFIX=library-v2/
S3_CDN_URL=
# Optional short-lived direct GET redirects when no CDN is configured.
S3_PRESIGNED_READS=false
# Browser-facing origin, with no path. HTTPS is required except for loopback development.
BASE_URL=http://localhost:5173
