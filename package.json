{
  "name": "picwall2",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  },
  "scripts": {
    "dev": "bun run --parallel dev:web dev:server",
    "dev:web": "bun node_modules/vite/bin/vite.js",
    "dev:server": "bun --watch server/index.ts",
    "build": "bun run typecheck && bun scripts/build.ts",
    "start": "NODE_ENV=production bun dist/server/index.js",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test",
    "import:photos": "bun scripts/import_photos.ts",
    "library": "bun scripts/library.ts",
    "auth": "bun scripts/auth.ts"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13",
    "date-fns": "^4.1.0",
    "exifreader": "^4.44.0",
    "hono": "^4.13.5"
  },
  "overrides": {
    "flatted": "^3.4.2"
  },
  "devDependencies": {
    "@simplewebauthn/browser": "^13",
    "@types/bun": "1.4.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "motion": "^12.31.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^6.1.0",
    "wouter": "^3.9.0"
  }
}
