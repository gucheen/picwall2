{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "outDir": "dist",
    "verbatimModuleSyntax": false // Often causes issues with CommonJS/ESM interop if true for server build
  },
  "include": ["server/**/*", "types/**/*"],
  "exclude": ["src", "node_modules", "**/*.test.ts"]
}
